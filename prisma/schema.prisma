// ─── Match & Connect: employers, contacts, and employer-linked openings ──────
// Phase 3 of docs/superpowers/plans/2026-09-05-match-and-connect.md
// (shape from the design spec §4). Employer and EmployerContact are STAFF-ONLY
// under RLS; JobLead is the one row in this group a student may read, and only
// when it is open and visible to a class they are actively enrolled in.

/// A real local employer. Backfilled once from the distinct free-text
/// `Opportunity.company` and `SpokesRecord.employerName` strings that were the
/// program's only employer record before this table existed.
model Employer {
  id String @id @default(cuid())

  name String
  /// Case-folded, whitespace-collapsed `name`. Not in the design spec's field
  /// list: it is the mechanism that makes "find or create by name" idempotent
  /// and race-safe. The backfill and the from-listing route both need that —
  /// without a unique key, two instructors clicking "Make this a lead" on the
  /// same posting create two Mountain Metals.
  nameKey   String   @unique
  legalName String?
  sector    String?
  clusters  String[] @default([])

  county  String
  city    String
  zip     String?
  website String?
  notes   String? @db.Text

  /// The staff member who owns this relationship (Student row with a staff role).
  relationshipOwnerId String?

  hiredSpokesGradBefore Boolean   @default(false)
  lastHiredAt           DateTime?

  /// {eip, esp, ojt, wotc, bonding} as "known" / "unknown" — never a bare
  /// boolean, because "we have not asked" and "no" are different answers and
  /// the console shows them differently.
  subsidyFlags Json @default("{}")

  /// active | paused | do_not_contact
  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationshipOwner Student?          @relation("EmployerRelationshipOwner", fields: [relationshipOwnerId], references: [id], onDelete: SetNull)
  contacts          EmployerContact[]
  jobLeads          JobLead[]
  connections       Connection[]

  @@index([status, county])
  @@schema("visionquest")
}

/// A person at an employer. Students never read this table — the RLS policy
/// has no student branch at all, and there is no route that returns it to one.
model EmployerContact {
  id         String @id @default(cuid())
  employerId String

  name  String
  role  String?
  email String?
  phone String?

  /// email | phone | sms
  preferredChannel String @default("email")

  /// They agreed to receive packets. Null = never asked.
  contactConsentAt DateTime?
  /// Set = never contact this person again, whatever the employer status says.
  doNotContactAt DateTime?

  createdAt DateTime @default(now())

  employer Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  jobLeads JobLead[]

  @@index([employerId])
  @@schema("visionquest")
}

/// An employer-linked opening — the thing a student is matched TO. Distinct
/// from JobListing (a scraped third-party posting) because a lead has a named
/// employer, a contact, requirements the instructor typed, and a shift
/// schedule the matcher can actually reason about.
model JobLead {
  id         String  @id @default(cuid())
  employerId String
  contactId  String?

  /// Which class may see this lead. NULL = program-wide. Students read a lead
  /// only when it is open AND (classId IS NULL OR they are actively enrolled
  /// in that class) — enforced in the RLS policy, not only in the app.
  classId String?

  title       String
  description String? @db.Text

  /// { mustHaveCerts: string[], niceToHave: string[], physical: string[], licenses: string[] }
  requirements Json @default("{}")

  /// { shifts: ("day"|"evening"|"night"|"weekend")[], hoursPerWeekMin?, hoursPerWeekMax?, startDate? }
  schedule Json @default("{}")

  payMin Float?
  payMax Float?
  /// hour | day | week | month | year — normalized to hourly by the salary parser.
  payPeriod String @default("hour")

  location      String
  transitNotes  String?
  distanceMiles Float?

  clusters String[] @default([])

  /// manual | opportunity | joblisting | joborder
  source String
  /// Opportunity.id or JobListing.id when this lead was copied from one.
  sourceRef String?

  /// open | filled | paused | closed
  status   String @default("open")
  openings Int    @default(1)

  postedAt DateTime  @default(now())
  closesAt DateTime?

  /// The staff member who entered it.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employer  Employer         @relation(fields: [employerId], references: [id], onDelete: Cascade)
  contact   EmployerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  class     SpokesClass?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdBy Student?         @relation("CreatedJobLeads", fields: [createdById], references: [id], onDelete: SetNull)

  connections    Connection[]
  resumeVersions ResumeVersion[]
  coverLetters   CoverLetter[]

  @@index([status, employerId])
  @@index([source, sourceRef])
  @@schema("visionquest")
}

model Application {
  id            String    @id @default(cuid())
  studentId     String
  opportunityId String
  status        String    @default("saved")
  notes         String?   @db.Text
  resumeFileId  String?
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // P1-4 outcome verification: null = legacy row (pre-feature, provenance
  // unknown); "self_reported" = student-claimed status change; "verified" =
  // an instructor confirmed the application outcome. Carried for grant
  // reporting — reports split verified vs self-reported outcomes.
  verificationStatus String?
  verifiedBy         String?
  verifiedAt         DateTime?
  // Pathway provenance — what the student's suggested SPOKES career pathway
  // WAS at the moment this application row was created, copied from
  // CareerDiscovery.topClusters[0]. Null = no cluster existed then, or a
  // legacy row created before this field. WRITE-ONCE by design: never
  // updated when discovery changes later. The whole point is to ask "did the
  // pathway we suggested at the time lead to a placement" (via
  // SpokesRecord.placementApplicationId), and a retroactive rewrite would
  // destroy the only evidence that question has. See src/lib/pathway-
  // provenance.ts (capture) and src/lib/pathway-outcomes.ts (report).
  pathwayClusterId   String?
  pathwaySnapshotAt  DateTime?

  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  spokesPlacement SpokesRecord? @relation("PlacementProvenance")
  connection      Connection?

  @@unique([studentId, opportunityId])
  @@index([studentId, status])
  @@schema("visionquest")
}

// ─── Match & Connect Phase 4: the Connection ─────────────────────────────────
// docs/superpowers/plans/2026-09-05-match-and-connect.md Task 4.1
// (shape from the design spec §4). A Connection is the only object in this
// program that causes a student's information to leave it, so its status
// pipeline lives in a table (src/lib/connect/pipeline-shared.ts), every
// transition writes an append-only ConnectionEvent, and the packet the student
// approved is FROZEN in `packet` rather than re-derived at send time.

/// One student introduced to one employer for one opening.
model Connection {
  id         String @id @default(cuid())
  studentId  String
  jobLeadId  String
  /// Denormalized from the lead so the per-employer send limit, the
  /// do-not-contact check and the funnel do not have to join through JobLead
  /// on every read. A lead never changes employer.
  employerId String

  /// The staff member or the student who proposed it.
  proposedById String
  /// teacher | sage | student — how the proposal was raised.
  proposedVia String @default("teacher")

  /// See CONNECTION_STATUSES in src/lib/connect/pipeline-shared.ts.
  status          String   @default("proposed")
  statusChangedAt DateTime @default(now())

  /// The `employer_referral` consent that was active when the student approved.
  consentRecordId String?

  /// The frozen packet (src/lib/connect/packet-shared.ts `packetSchema`):
  /// resumeVersionId, coverLetterId, endorsement, includedCertIds,
  /// includedFields and the rendered values. Written at approval, never after.
  packet Json?

  sentById String?
  sentAt   DateTime?

  /// sha256 of the employer's link token. The token itself is shown once, in
  /// the email, and is never stored or logged.
  employerTokenHash String?   @unique
  tokenExpiresAt    DateTime?
  /// The contact the token was minted for. A link is good for one person.
  tokenContactId String?

  employerViewedAt    DateTime?
  employerRespondedAt DateTime?
  /// interested | not_now | hired
  employerResponse String?
  responseReason   String?

  interviewAppointmentId String?

  hiredAt    DateTime?
  startDate  DateTime?
  hourlyWage Float?

  /// The verified Application this hire produced, so the placement bridge and
  /// the grant KPI report see it exactly as they see a self-directed one.
  applicationId String? @unique

  closedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student             Student           @relation("StudentConnections", fields: [studentId], references: [id], onDelete: Cascade)
  jobLead             JobLead           @relation(fields: [jobLeadId], references: [id], onDelete: Cascade)
  employer            Employer          @relation(fields: [employerId], references: [id], onDelete: Cascade)
  proposedBy          Student           @relation("ProposedConnections", fields: [proposedById], references: [id], onDelete: Cascade)
  sentBy              Student?          @relation("SentConnections", fields: [sentById], references: [id], onDelete: SetNull)
  consentRecord       ConsentRecord?    @relation(fields: [consentRecordId], references: [id], onDelete: SetNull)
  interviewAppointment Appointment?     @relation("InterviewAppointment", fields: [interviewAppointmentId], references: [id], onDelete: SetNull)
  application         Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  events              ConnectionEvent[]
  messages            OutboundMessage[]

  @@unique([studentId, jobLeadId])
  @@index([studentId, status])
  @@index([employerId, status])
  @@index([status, statusChangedAt])
  @@schema("visionquest")
}

/// Append-only: every status change, plus the employer's views. There is no
/// UPDATE or DELETE policy on this table — an audit trail that can be edited
/// is not one.
model ConnectionEvent {
  id           String @id @default(cuid())
  connectionId String

  fromStatus String?
  toStatus   String

  /// student | teacher | admin | employer | system
  actorType String
  /// Student.id for a staff or student actor; NULL for the employer, who has
  /// no account here, and for system transitions.
  actorId String?
  note    String? @db.Text

  at DateTime @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, at])
  @@schema("visionquest")
}

/// Every message this program sent out about a connection — the audit trail
/// the SMS/email layer lacks today (design spec §4). Staff-read only.
model OutboundMessage {
  id      String @id @default(cuid())
  /// sms | email
  channel String
  /// student | employer_contact | staff
  toKind String
  /// Student.id or EmployerContact.id. Never a raw address: the address lives
  /// on the row it belongs to, and this table is read by staff, not by a
  /// mailer.
  toId        String
  templateKey String
  /// The rendered body as sent. It contains only what the student approved.
  body       String  @db.Text
  providerId String?
  /// queued | sent | failed
  status String @default("sent")

  connectionId String?

  sentAt DateTime @default(now())

  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([connectionId, sentAt])
  @@index([toKind, toId, sentAt])
  @@schema("visionquest")
}

model CareerEvent {
  id                   String   @id @default(cuid())
  title                String
  description          String?  @db.Text
  startsAt             DateTime
  endsAt               DateTime
  location             String?
  virtualUrl           String?
  capacity             Int?
  registrationRequired Boolean  @default(true)
  status               String   @default("scheduled")
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  createdBy     Student?            @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: SetNull)
  registrations EventRegistration[]

  @@index([status, startsAt])
  @@schema("visionquest")
}

model EventRegistration {
  id           String   @id @default(cuid())
  studentId    String
  eventId      String
  status       String   @default("registered")
  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event   CareerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([studentId, eventId])
  @@index([studentId, status])
  @@schema("visionquest")
}

model PublicCredentialPage {
  id        String   @id @default(cuid())
  studentId String   @unique
  slug      String   @unique
  headline  String?
  summary   String?  @db.Text
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@schema("visionquest")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  studentId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, expiresAt])
  @@schema("visionquest")
}

model SecurityQuestionAnswer {
  id          String   @id @default(cuid())
  studentId   String
  questionKey String
  answerHash  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionKey])
  @@index([studentId])
  @@schema("visionquest")
}

model Notification {
  id        String    @id @default(cuid())
  studentId String
  type      String
  title     String
  body      String?   @db.Text
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, read, createdAt(sort: Desc)])
  @@schema("visionquest")
}

model RateLimitEntry {
  key       String   @id
  count     Int      @default(0)
  resetTime DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetTime])
  @@schema("visionquest")
}

/// Consumed Sage confirm-card tokens: one row per executed confirmation,
/// keyed by token sha256. /api/chat/tool-confirm claims insert-first
/// (src/lib/sage/agent/confirmation-use.ts), so a duplicate insert is a
/// replay and is refused — a token authorizes exactly one execution. Rows
/// stop mattering once expiresAt passes (HMAC verification already rejects
/// expired tokens) and are swept opportunistically on claim.
model SageConfirmationUse {
  tokenHash String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@schema("visionquest")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  targetType String
  targetId   String?
  summary    String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@schema("visionquest")
}

model FormSubmission {
  id              String    @id @default(cuid())
  studentId       String
  formId          String
  fileId          String
  signatureFileId String?
  status          String    @default("pending")
  reviewedBy      String?
  reviewedAt      DateTime?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, formId])
  @@index([studentId, status])
  @@schema("visionquest")
}

// =============================================================================
// Structured Forms (Phase 4)
// JSON-schema-backed templates with typed field definitions, assignable to
// classes or individual students, filled out via the student portal, reviewed
// by teachers, and exported to CSV for grant reporting.
// Coexists with the PDF FormSubmission pipeline above — both tracks remain.
// =============================================================================

model FormTemplate {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  programTypes String[] @default([])
  schema       Json
  status       String   @default("active")
  isOfficial   Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy   Student?         @relation("CreatedFormTemplates", fields: [createdById], references: [id], onDelete: SetNull)
  assignments FormAssignment[]
  responses   FormResponse[]

  @@index([status, title])
  @@schema("visionquest")
}

model FormAssignment {
  id                    String    @id @default(cuid())
  templateId            String
  assignedById          String?
  scope                 String
  targetId              String
  dueAt                 DateTime?
  requiredForCompletion Boolean   @default(false)
  createdAt             DateTime  @default(now())

  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedBy Student?     @relation("CreatedFormAssignments", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([scope, targetId])
  @@index([templateId])
  @@schema("visionquest")
}

model FormResponse {
  id            String    @id @default(cuid())
  templateId    String
  studentId     String
  answers       Json
  status        String    @default("draft")
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewerNotes String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  student    Student      @relation("FormResponses", fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy Student?     @relation("ReviewedFormResponses", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([templateId, studentId])
  @@index([studentId, status])
  @@index([templateId, status])
  @@schema("visionquest")
}

// =============================================================================
// Program Documents
// Stores program-level PDFs, forms, and reference materials in Supabase Storage.
// These are NOT student-specific — they belong to the program itself.
// =============================================================================

model ProgramDocument {
  id String @id @default(cuid())

  // --- Display Info ---
  title       String // Human-readable name, e.g. "IC3 Study Guide"
  description String? @db.Text // Optional summary for Sage and UI tooltips

  // --- Storage ---
  storageKey String @unique // Supabase Storage path, e.g. "documents/lms/ic3-study-guide.pdf"
  mimeType   String @default("application/pdf")
  sizeBytes  Int?

  // --- Classification ---
  // Document category determines folder and display context
  category ProgramDocCategory
  // Who can see/access this document
  audience ProgramDocAudience @default(BOTH)

  // --- Linking to Certifications & Platforms ---
  // Optional: link this document to a specific certification ID (from certifications.ts)
  certificationId String? // e.g. "ic3", "mos-word", "workkeys-ncrc"
  // Optional: link this document to a specific platform ID (from platforms.ts)
  platformId      String? // e.g. "gmetrix-and-learnkey", "edgenuity"

  // --- Sage AI Context ---
  // If true, this document's description is injected into Sage's knowledge base
  usedBySage      Boolean   @default(false)
  // Short text summary Sage can read (avoids loading full PDF into prompt)
  sageContextNote String?   @db.Text
  fileModifiedAt  DateTime? // Filesystem mtime at ingestion — for change detection

  // --- Semantic Retrieval (Phase 1 — hybrid RAG) ---
  // gemini-embedding-001 @ 768 dims over `title + sageContextNote`.
  // Read/written only via $queryRaw/$executeRaw (Prisma Unsupported type).
  // Manual SQL objects NOT representable here (see migrations):
  //   - HNSW index ProgramDocument_embedding_hnsw_idx (vector_cosine_ops)
  //   - GIN expression index ProgramDocument_fts_idx on
  //     to_tsvector('english', title || ' ' || coalesce(sageContextNote, ''))
  //   - Function visionquest.sage_hybrid_search(...) — RRF hybrid retrieval
  embedding      Unsupported("vector(768)")?
  // Provenance: which embedding model produced `embedding` (and the doc's
  // chunk vectors). Used to guard cross-model semantic search and to select
  // stale rows for re-embedding. Null = never embedded.
  embeddingModel String?
  chunks         DocumentChunk[]

  // --- Metadata ---
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  uploadedBy String? // studentId of teacher who uploaded
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category, audience, isActive])
  @@index([certificationId])
  @@index([platformId])
  @@index([usedBySage, isActive])
  @@schema("visionquest")
}

// Chunked bodies of extractable-text ProgramDocuments (~512-token chunks,
// 50-token overlap) embedded for semantic retrieval. Scanned/image docs have
// no chunks — their doc-level embedding (title + sageContextNote) suffices.
// Manual SQL (see migrations): HNSW index DocumentChunk_embedding_hnsw_idx,
// RLS policies mirroring program_document_read/write.
model DocumentChunk {
  id             String                      @id @default(cuid())
  documentId     String
  chunkIndex     Int
  content        String                      @db.Text
  embedding      Unsupported("vector(768)")?
  // Provenance: which embedding model produced `embedding` (see ProgramDocument).
  embeddingModel String?
  tokenCount     Int?
  pageNumber     Int?
  sectionTitle   String?
  // fts is a GENERATED tsvector managed in raw SQL (see add_chunk_provenance
  // migration). Prisma cannot express GENERATED columns; declared Unsupported
  // so it stays out of drift detection — do NOT accept a migrate-dev drop diff.
  fts            Unsupported("tsvector")?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  document ProgramDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@schema("visionquest")
}

// Durable Sage memory (Phase 2). One row = one fact about a subject.
// kind: episodic (events/sessions) | semantic (stable facts/preferences) |
// procedural (what works when coaching this subject).
// Temporal validity (Graphiti pattern): active rows have validTo = NULL;
// superseded/expired rows keep history. sourceHash dedupes re-extraction
// (TEKTON pattern): sha256 over normalized subject + content.
// Manual SQL (see migration): HNSW index SageMemory_embedding_hnsw_idx,
// partial unique index on (subjectType, subjectId, sourceHash) WHERE
// "validTo" IS NULL, RLS (students read/insert own rows only).
model SageMemory {
  id                String                      @id @default(cuid())
  subjectType       String // student | teacher | class | program
  subjectId         String
  kind              String // episodic | semantic | procedural
  content           String                      @db.Text
  embedding         Unsupported("vector(768)")?
  // Provenance guard: only compare memory vectors produced by the active model.
  embeddingModel    String?
  category          String // goal | preference | circumstance | skill | coaching | progress | other
  confidence        Float                       @default(0.7)
  validFrom         DateTime                    @default(now())
  validTo           DateTime?
  lastDecayedAt     DateTime?
  suppressedByStaff Boolean                     @default(false)
  sourceType        String // conversation | operation | manual
  sourceId          String?
  sourceHash        String
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  edgesFrom SageMemoryEdge[] @relation("MemoryEdgeFrom")
  edgesTo   SageMemoryEdge[] @relation("MemoryEdgeTo")

  @@index([subjectType, subjectId, validTo])
  @@index([sourceType, sourceId])
  @@schema("visionquest")
}

// Typed relationships between memories with evidence (TEKTON pattern).
model SageMemoryEdge {
  id         String   @id @default(cuid())
  fromId     String
  toId       String
  predicate  String // depends_on | blocks | supersedes | relates_to | evidenced_by
  evidence   String   @db.Text
  confidence Float    @default(0.7)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  from SageMemory @relation("MemoryEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   SageMemory @relation("MemoryEdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
  @@schema("visionquest")
}

// Certification/platform progression structure as data (issue #140).
// fromId depends on toId (kind "prerequisite"). Endpoints are static ids
// from src/lib/spokes/{certifications,platforms}.ts — no FK targets exist,
// so referential integrity is locked by progression-edges.test.ts instead.
// Program-wide reference data: read-open, admin-only writes (RLS Pattern L).
model ProgressionEdge {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  kind      String   @default("prerequisite")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromId, toId, kind])
  @@index([fromId])
  @@index([toId])
  @@schema("visionquest")
}

// Recorded student consent (Phase 3). Active consent = grantedAt set and
// revokedAt null for the scope. History preserved: revocation closes the row;
// re-granting creates a new one. scope: cloud_file_processing (Gemini Files
// API may process this student's uploaded documents).
model ConsentRecord {
  id         String    @id @default(cuid())
  studentId  String
  scope      String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
  recordedBy String // student id (self-service) or staff id
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  connections Connection[]

  @@index([studentId, scope, revokedAt])
  @@schema("visionquest")
}

// Operation ledger: every Sage write action records here (Phase 3 write
// tools consume this). Deterministic ids ("op-{timestamp}-{slug}") make
// repeated tool invocations idempotent and auditable.
model SageOperation {
  id            String   @id
  actorType     String // student | teacher | admin | system
  actorId       String
  // The student the operation acted ON (actorType/actorId is the invoker).
  // Equals actorId for student self-service writes; the target student for
  // staff on-behalf-of writes. Null = legacy row (pre-2026-08) or no student
  // target. No FK on purpose — like actorId, ledger rows must survive
  // student offboarding.
  targetStudentId String?
  toolName      String
  status        String // proposed | confirmed | executed | failed | rejected
  payload       Json
  resultSummary String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([actorType, actorId])
  @@index([targetStudentId])
  @@index([toolName, status])
  @@schema("visionquest")
}

// Sage predictive wager — a hypothesis Sage stakes on an observable outcome
// for a student (e.g. "will reach weekly goal by Friday"). Verdicts are
// resolved by the background verdict-runner and feed the Sage learning loop.
// Manual SQL (see migration 20260625000000_add_wager_models): RLS read-only
// for vq_app; prismaAdmin (bypass) handles writes.
model Wager {
  id                String   @id @default(cuid())
  studentId         String
  wagerType         String
  targetType        String
  targetId          String
  sourceOperationId String?
  sourceMessageId   String?
  hypothesis        String   @db.Text
  predictedOutcome  String
  confidence        Float?
  horizonAt         DateTime
  status            String   @default("open")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verdict WagerVerdict?

  @@unique([targetType, targetId, wagerType])
  @@index([status, horizonAt])
  @@index([studentId, wagerType])
  @@schema("visionquest")
}

// Resolved verdict for a Wager. Created by the verdict-runner once horizonAt
// passes and the predicted outcome can be evaluated against observable data.
model WagerVerdict {
  id                String   @id @default(cuid())
  wagerId           String   @unique
  outcome           String
  result            String
  resolvedBy        String
  evidence          Json
  observedAt        DateTime @default(now())
  diagnosis         String?  @db.Text
  diagnosisModel    String?
  knowledgeUpdateId String?
  createdAt         DateTime @default(now())

  wager Wager @relation(fields: [wagerId], references: [id], onDelete: Cascade)

  @@schema("visionquest")
}

// =============================================================================
// Career Campaign Orchestrator — resumable DISCOVER→PREP→QUEUE→TRACK planner.
// advanceCampaign() (src/lib/sage/campaign/) is a pure function with no I/O;
// these models are written only by the thin recordCampaignStep() persistence
// caller. CampaignStep.proposedActions is always a PROPOSAL — no consequential
// action is executed by the planner itself.
// =============================================================================

model CareerCampaign {
  id                      String   @id @default(cuid())
  studentId               String
  status                  String   @default("active") // active | paused | completed
  targetClusters          String[] @default([])
  currentStage            String   @default("discover") // discover | prep | queue | track
  weeklyApplicationTarget Int      @default(3)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  steps   CampaignStep[]

  @@index([studentId, status])
  @@schema("visionquest")
}

model CampaignStep {
  id              String   @id @default(cuid())
  campaignId      String
  stage           String // discover | prep | queue | track
  proposedActions Json
  createdAt       DateTime @default(now())

  campaign CareerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@schema("visionquest")
}

