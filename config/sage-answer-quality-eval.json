  {
    "id": "answer-refund-1",
    "family": "grounding",
    "role": "student",
    "stage": "general",
    "message": "What is the SPOKES program refund policy?",
    "rubric": "refund",
    "assert": {
      "mustContainAny": [
        "instructor",
        "teacher",
        "caseworker",
        "doctor",
        "healthcare",
        "health care",
        "medical professional",
        "pharmacist",
        "testing center"
      ],
      "mustNotMatch": [
        {
          "label": "unsupported refund amount or percentage",
          "pattern": "\\$\\s*\\d|\\b\\d+\\s*(?:percent|%)"
        },
        {
          "label": "unsupported refund deadline",
          "pattern": "\\b(?:within|after|before)\\s+(?:\\d+|seven|fourteen|thirty)\\s+days?\\b"
        },
        {
          "label": "unsupported absence of fees or refund policy",
          "pattern": "\\b(?:there (?:is|are) no|has no)\\s+(?:tuition|fees?|refund|money to refund)|\\bno refund policy\\b|\\b(?:SPOKES is|it is|it\\x27s)\\s+(?:a\\s+)?free\\b"
        }
      ],
      "acknowledgementAny": [
        "can't",
        "cannot",
        "don't",
        "do not",
        "couldn't",
        "not available",
        "not cover",
        "not include",
        "not provide",
        "doesn't",
        "does not",
        "no information",
        "unable",
        "not have",
        "could not"
      ]
    },
    "redBaseline": {
      "goodReply": "I couldn't find a refund policy in the available documents. Please ask your instructor.",
      "badReply": "You can receive a $50 refund within 30 days. Ask your instructor."
    }
  },
