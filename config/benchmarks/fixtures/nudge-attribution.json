      "connections": [{ "id": "con0", "student": 0, "status": "started" }],
      "questions": [
        { "student": 0, "templateKey": "retention_30", "token": "retention:con0:30", "sentHoursAgo": 2 }
      ],
      "inbound": [{ "phone": 0, "body": "STOP" }],
      "expect": {
        "outcomes": [{ "outcome": "revoked" }],
